# ENQORA — Variables de entorno (solo referencia)
# Los valores reales NO van aquí: se cargan en Vercel → Settings → Environment Variables.
# Nunca uses la clave "service_role" ni una clave secreta de Supabase: este proyecto no la necesita.

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Supabase → Project Settings → API Keys → clave "publishable" (o "anon")
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Dominio público de la app en Vercel, sin barra final
NEXT_PUBLIC_SITE_URL=https://enqora.vercel.app

# --- Opcionales (Etapa 3: alertas por correo de dispositivo nuevo) ---
# Resend → API Keys. Solo en el servidor: NO lleva el prefijo NEXT_PUBLIC_.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# Remitente. Mientras no verifiques un dominio en Resend, usa el de pruebas.
ALERT_EMAIL_FROM=ENQORA <onboarding@resend.dev>
